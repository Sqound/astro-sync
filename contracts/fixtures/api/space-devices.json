          "authorization": "Bearer wl2zxC3Dt4HJgMfhEiU4pUwq0oeW9ODmY8T3moyhKm4"
        }
      },
      "response": { "status": 204, "headers": {}, "body": null }
    },
    {
      "id": "detach-this-device",
      "description": "« Détacher cet appareil », the only way out. The application first sends what it has not sent yet, then calls this route, then erases the copy of the space; plans made without a space stay.",
      "given": {
        "authMode": "email-code",
        "now": "2026-09-29T21:14:00.000Z",
        "deviceLastLeftASpaceAt": null
